{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3101/offline",
        "http://localhost:3101/",
        "http://localhost:3101/universities",
        "http://localhost:3101/universities/alpha-university",
        "http://localhost:3101/campus-tours",
        "http://localhost:3101/sign-in",
        "http://localhost:3101/contact"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 204800
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
