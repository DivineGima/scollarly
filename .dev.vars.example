# Copy to .dev.vars for local `wrangler dev` / `opennextjs-cloudflare preview`. .dev.vars is git-ignored.
# In deployed Workers the Stage 0 workflow sets each value from repository secrets. Never commit real values.

# Connection string of the NON-OWNER runtime role `app_runtime` (ADR-038), pooled. Never the owner's string.
DATABASE_URL=postgres://app_runtime:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth (ADR-037): the branch's Auth URL (it includes a path), and a cookie secret of at least 32 characters
# (openssl rand -base64 32). Google credentials are set in the Neon console, not here.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-32-plus-random-characters

# Encrypts the owner's authenticator secret: base64 of 32 random bytes (openssl rand -base64 32).
TOTP_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Salts the hashed caller key of the rate limiter. Never a raw IP.
RATE_LIMIT_SECRET=replace-with-32-plus-random-characters

# Neon Object Storage (ADR-039). The endpoint and region come from the branch; the credential has write scope only.
# Reads of public images need no credential.
NEON_STORAGE_ENDPOINT=https://br-xxxx.storage.c-7.region.aws.neon.tech
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Cloudflare Turnstile. The documented always-pass test secret works for local runs:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# First verified sign-in with this email becomes the owner (architecture 9.3).
OWNER_EMAIL=owner@example.com

# Shared secret of the CPU measurement workflow: a lead POST carrying it in the x-phase0-token header skips Turnstile and is stamped as a test lead.
PHASE0_PROBE_TOKEN=replace-with-a-long-random-string
